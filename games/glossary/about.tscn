[node name="Label3" type="RichTextLabel" parent="CanvasLayer/VBoxContainer/HBoxContainer2"]
custom_minimum_size = Vector2(400, 400)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("6_x5r8a")
theme_override_font_sizes/normal_font_size = 21
text = "We, the students of Information Technology from Western Institute of Technology created this game  as part of our Capstone project.
We wanted to combine what we’ve learned in programming, design, and education into something that’s both interactive and meaningful, a game that teaches science in a fun, story-driven way.

Our goal is to make learning feel like an adventure, not a lecture. Every challenge, puzzle, and scene in this game was designed to help players experience science, not just read about it.
"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Label4" type="RichTextLabel" parent="CanvasLayer/VBoxContainer/HBoxContainer2"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("6_x5r8a")
theme_override_font_sizes/normal_font_size = 21
text = "This game was created for Senior High School students of the Western Institute of Technology. For those who are curious, creative, and passionate about learning through play.

As a fellow student, we hope this game helps other students build a foundation of understanding in which they can see General Chemistry.

It’s our way of showing that learning can be exciting, inspiring, and full of adventure just like the journey of Auron himself."
horizontal_alignment = 1
vertical_alignment = 1
metadata/_edit_use_anchors_ = true

